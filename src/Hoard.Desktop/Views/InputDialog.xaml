<ui:FluentWindow x:Class="Hoard.Desktop.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hoard" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="Hoard" ShowMaximize="False" ShowMinimize="False"/>
    <StackPanel Grid.Row="1" Margin="20,8,20,20">
      <TextBlock x:Name="Prompt" Style="{StaticResource Note}" Margin="0,0,0,8"/>
      <ui:TextBox x:Name="Input" ClearButtonEnabled="True"/>
      <PasswordBox x:Name="Secret" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <ui:Button Content="OK" Appearance="Primary" IsDefault="True" Click="OnOkClick" MinWidth="90" Margin="0,0,8,0"/>
        <ui:Button Content="Cancel" IsCancel="True" MinWidth="90"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
