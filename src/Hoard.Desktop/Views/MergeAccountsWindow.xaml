<ui:FluentWindow x:Class="Hoard.Desktop.Views.MergeAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hoard - Merge duplicate accounts" Width="900" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Merge duplicate accounts" ShowMaximize="False" ShowMinimize="False"/>

    <StackPanel Grid.Row="1" Margin="20,4,20,8">
      <TextBlock Style="{StaticResource Note}"
                 Text="When a bank is removed and reconnected at SimpleFIN it hands out new account ids, so the next sync creates a second copy of each account. Each pair below is one account seen twice. Merging keeps the account on the left — its name, type, owner and history — folds in the transactions it is missing from the one on the right, and hands it the live bank connection, so future syncs update it instead of creating another copy. Tick Keep newer to swap the sides."/>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <ui:Button Content="Merge" Icon="{ui:SymbolIcon Merge24}" Appearance="Primary" Command="{Binding MergeSelectedCommand}" IsEnabled="{Binding HasPairs}" Margin="0,0,8,0"/>
        <ui:Button Content="Not a duplicate" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding DismissSelectedCommand}" IsEnabled="{Binding HasPairs}" Margin="0,0,16,0"/>
        <ui:Button Content="Scan all accounts" Icon="{ui:SymbolIcon Search24}" Command="{Binding ScanCommand}" ToolTip="Looks through every account for pairs that match by bank, name and currency — for duplicates created before Hoard started flagging them."/>
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="2" Margin="20,0,20,8">
      <DataGrid ItemsSource="{Binding Pairs}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                Visibility="{Binding HasPairs, Converter={StaticResource BoolToVis}}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Keep" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding KeepText}" TextWrapping="Wrap" Margin="4,6"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Merge into it and delete" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding AbsorbText}" TextWrapping="Wrap" Margin="4,6" Style="{StaticResource Muted}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridCheckBoxColumn Header="Keep newer" Binding="{Binding KeepNewer, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,16" VerticalAlignment="Top"
                 Visibility="{Binding HasPairs, Converter={StaticResource InverseBoolToVis}}"/>
    </Grid>

    <ui:Card Grid.Row="3" Margin="20,0,20,8" Padding="12,8">
      <StackPanel>
        <TextBlock Text="Merge two accounts by hand" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
        <TextBlock Text="For a pair the scan did not catch. The first account survives; the second is folded into it and deleted." Style="{StaticResource Note}" Margin="0,0,0,6"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Keep" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="1" ItemsSource="{Binding AllAccounts}" SelectedItem="{Binding ManualKeep}" Margin="0,0,12,0"/>
          <TextBlock Grid.Column="2" Text="Merge in and delete" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="3" ItemsSource="{Binding AllAccounts}" SelectedItem="{Binding ManualAbsorb}" Margin="0,0,12,0"/>
          <ui:Button Grid.Column="4" Content="Merge these" Icon="{ui:SymbolIcon Merge24}" Command="{Binding MergeManualCommand}"/>
        </Grid>
      </StackPanel>
    </ui:Card>

    <DockPanel Grid.Row="4" Margin="20,0,20,16">
      <ui:Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90"/>
      <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
