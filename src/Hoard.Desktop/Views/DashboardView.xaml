<UserControl x:Class="Hoard.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Style="{StaticResource PagePanel}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Text="Owner" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox ItemsSource="{Binding OwnerOptions}" SelectedItem="{Binding SelectedOwner}" Width="170" Margin="0,0,12,0" ToolTip="Show only the accounts owned by one household member"/>
          <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource Note}">
            <Run Text="{Binding AsOfText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding LastSyncText, Mode=OneWay}"/>
          </TextBlock>
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
        </StackPanel>
      </DockPanel>

      <!-- KPI row -->
      <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,12">
        <ui:Card Margin="6" Padding="16,12">
          <StackPanel>
            <TextBlock Text="Net worth" Style="{StaticResource KpiLabel}"/>
            <TextBlock Text="{Binding NetWorth, StringFormat=C0}" Style="{StaticResource KpiValue}"/>
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" Padding="16,12">
          <StackPanel>
            <TextBlock Text="Assets" Style="{StaticResource KpiLabel}"/>
            <TextBlock Text="{Binding Assets, StringFormat=C0}" Style="{StaticResource KpiValue}"/>
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" Padding="16,12">
          <StackPanel>
            <TextBlock Text="Liabilities" Style="{StaticResource KpiLabel}"/>
            <TextBlock Text="{Binding Liabilities, StringFormat=C0}" Style="{StaticResource KpiValue}"/>
          </StackPanel>
        </ui:Card>
        <ui:Card Margin="6" Padding="16,12">
          <StackPanel>
            <TextBlock Text="Accounts" Style="{StaticResource KpiLabel}"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding AccountCount}" Style="{StaticResource KpiValue}"/>
              <TextBlock Text="{Binding ExcludedCount, StringFormat=' ({0} excluded)'}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
            </StackPanel>
          </StackPanel>
        </ui:Card>
      </UniformGrid>

      <!-- Balances by type chart -->
      <ui:Card Grid.Row="2" Padding="16,12" Margin="0,0,0,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Balances by account type" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
          <lvc:CartesianChart Series="{Binding TypeSeries}" XAxes="{Binding TypeXAxes}" YAxes="{Binding TypeYAxes}"
                              LegendPosition="Hidden" TooltipPosition="Right" Height="{Binding TypeChartHeight}"/>
        </DockPanel>
      </ui:Card>

      <!-- Type cards -->
      <ItemsControl Grid.Row="3" ItemsSource="{Binding Cards}" Margin="-6,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Margin="6" Padding="14,12" VerticalAlignment="Stretch">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                  <Border DockPanel.Dock="Left" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"
                          Background="{Binding Color, Converter={StaticResource HexToBrush}}"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Total, StringFormat=C0}" FontWeight="SemiBold" FontSize="16"
                             Foreground="{Binding Total, Converter={StaticResource AmountToBrush}}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" Margin="18,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Accounts}" Margin="18,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,2">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Balance, StringFormat=N2}" Margin="8,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="excluded" FontSize="10" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Name, Mode=OneWay}"/>
                          <Run Text="{Binding Bank, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </TextBlock>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </ScrollViewer>
</UserControl>
