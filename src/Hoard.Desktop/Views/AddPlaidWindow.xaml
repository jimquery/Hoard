<ui:FluentWindow x:Class="Hoard.Desktop.Views.AddPlaidWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hoard - Add institution (Plaid)" Width="900" Height="640" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        Loaded="OnLoaded" Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Add institution through Plaid" ShowMaximize="False" ShowMinimize="False"/>

    <!-- Step 1: keys and Plaid Link -->
    <StackPanel Grid.Row="1" Margin="20,4,20,8" Visibility="{Binding IsChoosingAccounts, Converter={StaticResource InverseBoolToVis}}">
      <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
        <Run Text="1. Copy your app's client id and secret from the "/><Hyperlink NavigateUri="https://dashboard.plaid.com/developers/keys" RequestNavigate="OnNavigate">Plaid dashboard</Hyperlink><Run Text=". Trial and paid plans use the Production secret; Sandbox is for test banks (user_good / pass_good)."/>
        <LineBreak/>
        <Run Text="2. Connect opens Plaid Link in your browser. Pick the bank and sign in there; your bank password goes to Plaid, never to Hoard."/>
        <LineBreak/>
        <Run Text="3. Back here, choose for each account whether it is new or an account Hoard already has (for example from SimpleFIN). Linked accounts keep their history."/>
      </TextBlock>

      <Grid MaxWidth="620" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Content="Environment" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" Margin="0,4" Width="200" HorizontalAlignment="Left"/>
        <Label Grid.Row="1" Content="Client id" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,4"/>
        <Label Grid.Row="2" Content="Secret" VerticalAlignment="Center"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="SecretBox" PasswordChanged="OnSecretChanged" Margin="0,4"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Muted}" Margin="2,0,0,4" TextWrapping="Wrap"
                   Text="Leave the secret blank to reuse the one saved with your other Plaid institutions."
                   Visibility="{Binding HasSavedSecret, Converter={StaticResource BoolToVis}}"/>
      </Grid>

      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <ui:Button Content="Connect a bank..." Icon="{ui:SymbolIcon Link24}" Appearance="Primary" Command="{Binding ConnectCommand}" Margin="0,0,8,0"/>
        <ui:Button Content="Reopen browser" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenBrowserCommand}" Margin="0,0,8,0"
                   Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource BoolToVis}}"/>
        <ui:Button Content="Stop waiting" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding StopWaitingCommand}"
                   Visibility="{Binding IsWaitingForBrowser, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </StackPanel>

    <!-- Step 2: link each Plaid account to a new or existing Hoard account -->
    <Grid Grid.Row="1" Margin="20,4,20,8" Visibility="{Binding IsChoosingAccounts, Converter={StaticResource BoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Style="{StaticResource Note}" Margin="0,0,0,8"
                 Text="Pick an existing account to have Plaid take it over: it keeps its name, type, owner, categories and full history, the old connection stops updating it, and Plaid's first download is matched against the history it already has instead of duplicating it. Removing this Plaid institution later hands such accounts back."/>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Plaid account" Binding="{Binding Name}" IsReadOnly="True" Width="220" FontWeight="SemiBold"/>
          <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" IsReadOnly="True" Width="130"/>
          <DataGridTextColumn Header="Balance" Binding="{Binding BalanceText}" IsReadOnly="True" Width="110"/>
          <DataGridTemplateColumn Header="Hoard account" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <Grid Grid.Row="2" Margin="0,8,0,0" MaxWidth="620" HorizontalAlignment="Left">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Connection name" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="320" HorizontalAlignment="Left"/>
      </Grid>
    </Grid>

    <DockPanel Grid.Row="2" Margin="20,0,20,16">
      <ui:Button DockPanel.Dock="Right" Content="Close" Click="OnCloseClick" IsCancel="True" MinWidth="90"/>
      <ui:Button DockPanel.Dock="Right" Content="Save" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="90">
        <ui:Button.Style>
          <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsChoosingAccounts}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding Succeeded}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
              <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
      </ui:Button>
      <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
