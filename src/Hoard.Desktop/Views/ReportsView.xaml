<UserControl x:Class="Hoard.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:Hoard.Desktop.Controls">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="ui:Card">
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
      <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style x:Key="ChartCard" TargetType="ui:Card">
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
      <Setter Property="Margin" Value="2,0,0,4"/>
    </Style>
  </UserControl.Resources>

  <Grid Style="{StaticResource PagePanel}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadAllCommand}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
      </StackPanel>
    </DockPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedReportIndex}">
      <!-- ============================== Net worth ============================== -->
      <TabItem Header="Net worth">
        <DockPanel Margin="0,8,0,0">
          <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-12,10">
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Net worth" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding NetWorthNow, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Change over range" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding NetWorthChange, StringFormat='+$#,##0;-$#,##0;$0'}" Style="{StaticResource TileValue}"
                           Foreground="{Binding NetWorthChange, Converter={StaticResource AmountToBrush}}"/>
                <TextBlock Text="{Binding NetWorthChangeDetail}" Style="{StaticResource KpiDetail}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Assets" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding AssetsNow, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Liabilities" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding LiabilitiesNow, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
          </UniformGrid>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Range" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="140" Margin="0,0,16,0"/>
            <CheckBox Content="Break down assets by account type" IsChecked="{Binding BreakDownByType}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <CheckBox Content="Include estimated history (before first sync)" IsChecked="{Binding IncludeEstimated}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ui:Button Content="Reset zoom" Icon="{ui:SymbolIcon ZoomFit24}" Command="{Binding ResetNetWorthZoomCommand}" Appearance="Transparent"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding NetWorthNote}" Style="{StaticResource Note}" Margin="0,6,0,0"/>
          <ui:Card Style="{StaticResource ChartCard}">
            <lvc:CartesianChart Series="{Binding NetWorthSeries}" XAxes="{Binding NetWorthXAxes}" YAxes="{Binding NetWorthYAxes}"
                                ZoomMode="X" FindingStrategy="CompareOnlyX" LegendPosition="Bottom" TooltipPosition="Top" MinHeight="260"/>
          </ui:Card>
        </DockPanel>
      </TabItem>

      <!-- ============================== Income vs. expenses ============================== -->
      <TabItem Header="Income vs. expenses">
        <DockPanel Margin="0,8,0,0">
          <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-12,10">
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Average monthly income" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding AverageIncome, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Average monthly expenses" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding AverageExpense, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Savings rate" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding SavingsRate, StringFormat=P0, TargetNullValue='—'}" Style="{StaticResource TileValue}"
                           Foreground="{Binding SavingsRate, Converter={StaticResource AmountToBrush}}"/>
                <TextBlock Text="{Binding SavingsDetail}" Style="{StaticResource KpiDetail}"/>
              </StackPanel>
            </ui:Card>
          </UniformGrid>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Show last" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding IncomeRangeOptions}" SelectedItem="{Binding SelectedIncomeRange}" Width="140"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding IncomeNote}" Style="{StaticResource Note}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Style="{StaticResource ChartCard}">
              <lvc:CartesianChart Series="{Binding IncomeSeries}" XAxes="{Binding IncomeXAxes}" YAxes="{Binding IncomeYAxes}"
                                  FindingStrategy="CompareOnlyX" LegendPosition="Bottom" TooltipPosition="Top" MinHeight="260" Cursor="Hand"
                                  controls:ChartClick.Command="{Binding IncomeChartClickedCommand}"/>
            </ui:Card>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <ui:Card Grid.Column="2" Style="{StaticResource ChartCard}">
              <DataGrid ItemsSource="{Binding IncomeRows}" SelectedItem="{Binding SelectedIncomeRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MouseDoubleClick="OnIncomeRowDoubleClick"
                        ToolTip="Double-click a month to see its spending">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Month" Binding="{Binding Month}" Width="*"/>
                  <DataGridTextColumn Header="Income" Binding="{Binding Income, StringFormat=C0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                  <DataGridTextColumn Header="Expenses" Binding="{Binding Expense, StringFormat=C0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                  <DataGridTemplateColumn Header="Net" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Net, StringFormat=C0}" HorizontalAlignment="Right" Foreground="{Binding Net, Converter={StaticResource AmountToBrush}}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Saved" Binding="{Binding SavingsRate, StringFormat=P0}" Width="60" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
              </DataGrid>
            </ui:Card>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ============================== Spending ============================== -->
      <TabItem Header="Spending">
        <DockPanel Margin="0,8,0,0">
          <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,-12,10">
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="{Binding SelectedMonth.Label, StringFormat='Spent in {0}'}" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding SpentThisMonth, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Same month last year" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding SpentPriorYear, StringFormat=C0}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding SpendingChangeText}" Style="{StaticResource KpiDetail}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Largest category group" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding TopGroupText}" Style="{StaticResource TileValue}" FontSize="18" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
              </StackPanel>
            </ui:Card>
          </UniformGrid>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Label" Width="180" Margin="0,0,16,0"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding SpendingNote}" Style="{StaticResource Note}"/>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="2*"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="3*"/>
            </Grid.RowDefinitions>
            <ui:Card Grid.Row="0" Style="{StaticResource ChartCard}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Last 12 months by category group" Style="{StaticResource CardTitle}"/>
                <lvc:CartesianChart Series="{Binding SpendingTrendSeries}" XAxes="{Binding SpendingTrendXAxes}" YAxes="{Binding SpendingTrendYAxes}"
                                    FindingStrategy="CompareOnlyX" LegendPosition="Right" TooltipPosition="Top" MinHeight="200" Cursor="Hand"
                                    controls:ChartClick.Command="{Binding TrendChartClickedCommand}"/>
              </DockPanel>
            </ui:Card>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ui:Card Grid.Column="0" Style="{StaticResource ChartCard}">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top">
                    <ui:Button DockPanel.Dock="Right" Content="All groups" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding ClearSpendingGroupCommand}" Appearance="Transparent"
                               Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding SpendingDetailTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
                  </DockPanel>
                  <Grid>
                    <!-- Hidden by opacity, never collapsed: a PieChart whose series change while collapsed keeps drawing the old ones. -->
                    <lvc:PieChart Series="{Binding SpendingPieSeries}" LegendPosition="Right" TooltipPosition="Center" MinHeight="240" Cursor="Hand"
                                  controls:ChartClick.Command="{Binding PieChartClickedCommand}">
                      <lvc:PieChart.Style>
                        <Style TargetType="lvc:PieChart">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedGroup}" Value="True">
                              <Setter Property="Opacity" Value="0"/>
                              <Setter Property="IsHitTestVisible" Value="False"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </lvc:PieChart.Style>
                    </lvc:PieChart>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedGroup, Converter={StaticResource BoolToVis}}">
                      <lvc:CartesianChart Series="{Binding GroupDetailSeries}" XAxes="{Binding GroupDetailXAxes}" YAxes="{Binding GroupDetailYAxes}"
                                          FindingStrategy="CompareOnlyY" LegendPosition="Bottom" TooltipPosition="Right" Height="{Binding GroupDetailHeight}" Cursor="Hand"
                                          controls:ChartClick.Command="{Binding GroupDetailChartClickedCommand}" controls:ChartClick.NearStrategy="CompareOnlyY"/>
                    </ScrollViewer>
                  </Grid>
                </DockPanel>
              </ui:Card>
              <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
              <ui:Card Grid.Column="2" Style="{StaticResource ChartCard}">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top">
                    <ui:Button DockPanel.Dock="Right" Content="Transactions" Icon="{ui:SymbolIcon Receipt24}" Command="{Binding OpenSpendingTransactionsCommand}" Appearance="Transparent"
                               ToolTip="Open the selected category's (or this month's) transactions"/>
                    <TextBlock Text="Categories" Style="{StaticResource CardTitle}"/>
                  </DockPanel>
                  <DataGrid ItemsSource="{Binding SpendingRows}" SelectedItem="{Binding SelectedSpendingRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                            HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MouseDoubleClick="OnSpendingRowDoubleClick">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120"/>
                      <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                      <DataGridTextColumn Header="This month" Binding="{Binding Current, StringFormat=C0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                      <DataGridTextColumn Header="Last year" Binding="{Binding Prior, StringFormat=C0}" Width="85" ElementStyle="{StaticResource RightCell}"/>
                      <DataGridTemplateColumn Header="Change" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Change, StringFormat='+#,##0;-#,##0;0'}" HorizontalAlignment="Right"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTextColumn Header="%" Binding="{Binding ChangePercent}" Width="64" ElementStyle="{StaticResource RightCell}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </DockPanel>
              </ui:Card>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ============================== Budget vs. actual ============================== -->
      <TabItem Header="Budget vs. actual">
        <DockPanel Margin="0,8,0,0">
          <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-12,10">
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Monthly target" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding BudgetTarget, StringFormat=C0}" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Spent (groups with a target)" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding BudgetActual, StringFormat=C0}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding BudgetActualDetail}" Style="{StaticResource KpiDetail}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Projected month end" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding BudgetProjected, StringFormat=C0}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding BudgetProjectedDetail}" Style="{StaticResource KpiDetail}"/>
              </StackPanel>
            </ui:Card>
            <ui:Card Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="Groups over target" Style="{StaticResource KpiLabel}"/>
                <TextBlock Text="{Binding BudgetGroupsOver}" Style="{StaticResource TileValue}"/>
                <TextBlock Text="{Binding BudgetGroupsDetail}" Style="{StaticResource KpiDetail}"/>
              </StackPanel>
            </ui:Card>
          </UniformGrid>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Month" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedBudgetMonth}" DisplayMemberPath="Label" Width="180" Margin="0,0,16,0"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding BudgetNote}" Style="{StaticResource Note}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Style="{StaticResource ChartCard}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Target vs. actual by category group" Style="{StaticResource CardTitle}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <lvc:CartesianChart Series="{Binding BudgetSeries}" XAxes="{Binding BudgetXAxes}" YAxes="{Binding BudgetYAxes}"
                                      FindingStrategy="CompareOnlyY" LegendPosition="Top" TooltipPosition="Right" Height="{Binding BudgetChartHeight}" Cursor="Hand"
                                      controls:ChartClick.Command="{Binding BudgetChartClickedCommand}" controls:ChartClick.NearStrategy="CompareOnlyY"/>
                </ScrollViewer>
              </DockPanel>
            </ui:Card>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <ui:Card Grid.Row="0" Style="{StaticResource ChartCard}">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top">
                    <ui:Button DockPanel.Dock="Right" Content="All groups" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding ShowAllBudgetHistoryCommand}" Appearance="Transparent"/>
                    <TextBlock Text="{Binding BudgetHistoryTitle}" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
                  </DockPanel>
                  <lvc:CartesianChart Series="{Binding BudgetHistorySeries}" XAxes="{Binding BudgetHistoryXAxes}" YAxes="{Binding BudgetHistoryYAxes}"
                                      FindingStrategy="CompareOnlyX" LegendPosition="Bottom" TooltipPosition="Top" MinHeight="200"/>
                </DockPanel>
              </ui:Card>
              <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
              <ui:Card Grid.Row="2" Style="{StaticResource ChartCard}">
                <DataGrid ItemsSource="{Binding BudgetRows}" SelectedItem="{Binding SelectedBudgetRow}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          SelectionChanged="OnBudgetRowSelected" MouseDoubleClick="OnBudgetRowDoubleClick">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="20">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource BudgetStatusBrush}}" ToolTip="{Binding StatusText}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*"/>
                    <DataGridTextColumn Header="Target" Binding="{Binding Target, StringFormat=C0}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Actual" Binding="{Binding Actual, StringFormat=C0}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Projected" Binding="{Binding Projected, StringFormat=C0}" Width="80" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTemplateColumn Header="Left" Width="80">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Variance, StringFormat='+#,##0;-#,##0;0'}" HorizontalAlignment="Right"
                                     Foreground="{Binding Variance, Converter={StaticResource AmountToBrush}}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Used" Binding="{Binding Used, StringFormat=P0}" Width="60" ElementStyle="{StaticResource RightCell}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </ui:Card>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Balances by account type -->
      <TabItem Header="Balances by account type">
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding TypeHeadline}" Style="{StaticResource Headline}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding TypeNote}" Style="{StaticResource Note}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <lvc:CartesianChart Series="{Binding TypeSeries}" XAxes="{Binding TypeXAxes}" YAxes="{Binding TypeYAxes}"
                                    LegendPosition="Hidden" TooltipPosition="Right" Height="{Binding TypeChartHeight}"/>
              </ScrollViewer>
            </ui:Card>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <ui:Card Grid.Column="2" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <DataGrid ItemsSource="{Binding TypeRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsTypeTotal}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                      <DataTrigger Binding="{Binding IsExcluded}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="28">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding IsTypeTotal, Converter={StaticResource BoolToVis}}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/>
                  <DataGridTextColumn Header="Institution" Binding="{Binding Institution}" Width="150"/>
                  <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat=N2}" Width="110" ElementStyle="{StaticResource RightCell}"/>
                  <DataGridTextColumn Header="" Binding="{Binding Note}" Width="150"/>
                </DataGrid.Columns>
              </DataGrid>
            </ui:Card>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- College savings -->
      <TabItem Header="College savings">
        <DockPanel Margin="0,8,0,0">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Account type" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding CollegeTypeOptions}" SelectedItem="{Binding SelectedCollegeType}" DisplayMemberPath="Name" Width="170" Margin="0,0,16,0"/>
            <TextBlock Text="Annual growth %" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ui:TextBox Text="{Binding CollegeRatePercent, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,16,0"/>
            <TextBlock Text="Monthly contribution (accounts without a planned figure)" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ui:TextBox Text="{Binding CollegeContributionOverride, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="auto (12-mo avg)" Width="130" Margin="0,0,10,0"
                        ToolTip="Applies to accounts with no planned figure of their own. Leave blank to use each account's average deposits over the last 12 months."/>
            <ui:Button Content="Recalculate" Appearance="Primary" Command="{Binding RecalculateCollegeCommand}"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding CollegeHeadline}" Style="{StaticResource Headline}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding CollegeNote}" Style="{StaticResource Note}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <lvc:CartesianChart Series="{Binding CollegeSeries}" XAxes="{Binding CollegeXAxes}" YAxes="{Binding CollegeYAxes}"
                                  LegendPosition="Bottom" TooltipPosition="Top" MinHeight="260"/>
            </ui:Card>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <ui:Card Grid.Column="2" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <DataGrid ItemsSource="{Binding CollegeRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionUnit="Cell">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOwnerTotal}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Owner / account" Binding="{Binding Account, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                  <DataGridTextColumn Header="" Binding="{Binding Detail, Mode=OneWay}" IsReadOnly="True" Width="150"/>
                  <DataGridTextColumn Header="Today" Binding="{Binding Balance, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" Width="85" ElementStyle="{StaticResource RightCell}"/>
                  <DataGridTemplateColumn Header="Planned / mo" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding PlannedText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsAccount, Converter={StaticResource BoolToVis}}"
                                 LostKeyboardFocus="OnPlannedLostFocus" KeyDown="OnPlannedKeyDown" HorizontalContentAlignment="Right"
                                 BorderThickness="0" Background="Transparent" Padding="4,2" ToolTip="Monthly contribution to assume for this account. Blank = use the page figure or the 12-month deposit average."/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Using / mo" Binding="{Binding Monthly, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" Width="85" ElementStyle="{StaticResource RightCell}"/>
                  <DataGridTextColumn Header="" Binding="{Binding MonthlySource, Mode=OneWay}" IsReadOnly="True" Width="85"/>
                  <DataGridTextColumn Header="At 18" Binding="{Binding ProjectedText, Mode=OneWay}" IsReadOnly="True" Width="95" ElementStyle="{StaticResource RightCell}"/>
                </DataGrid.Columns>
              </DataGrid>
            </ui:Card>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Subscriptions: recurring charges found by SubscriptionDetector -->
      <TabItem Header="Subscriptions">
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding SubscriptionHeadline}" Style="{StaticResource Headline}"/>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <CheckBox DockPanel.Dock="Right" Content="Active only" IsChecked="{Binding ActiveSubscriptionsOnly}" VerticalAlignment="Top" Margin="12,0,0,0"
                      ToolTip="Hide subscriptions whose charges have stopped (no charge within about one and three-quarter billing periods)"/>
            <TextBlock Text="{Binding SubscriptionNote}" Style="{StaticResource Note}" Margin="0"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <ui:Card Grid.Column="0" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Annual cost per vendor" Style="{StaticResource SectionTitle}" Margin="4,0,0,4"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <lvc:CartesianChart Series="{Binding SubscriptionSeries}" XAxes="{Binding SubscriptionXAxes}" YAxes="{Binding SubscriptionYAxes}"
                                      LegendPosition="Hidden" TooltipPosition="Right" Height="{Binding SubscriptionChartHeight}"/>
                </ScrollViewer>
              </DockPanel>
            </ui:Card>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <ui:Card Grid.Column="2" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Subscription charges" Style="{StaticResource SectionTitle}" Margin="4,0,0,4"/>
                <DataGrid ItemsSource="{Binding SubscriptionRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                  <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGrid.RowStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="90"/>
                    <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="150"/>
                    <DataGridTextColumn Header="Every" Binding="{Binding Cadence}" Width="70"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="120"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="Per year" Binding="{Binding AnnualCost, StringFormat=N2}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                    <DataGridTextColumn Header="" Binding="{Binding Status}" Width="60"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </ui:Card>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- ============================== Possible duplicates ============================== -->
      <TabItem Header="Possible duplicates">
        <DockPanel Margin="0,8,0,0" DataContext="{Binding Duplicates}">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Look back" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding RangeOptions}" SelectedItem="{Binding SelectedRange}" Width="130" Margin="0,0,16,0"/>
            <TextBlock Text="Within" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
            <ComboBox ItemsSource="{Binding WindowOptions}" SelectedItem="{Binding WindowDays}" Width="70" Margin="0,0,6,0"
                      ToolTip="How many days apart two copies may be posted"/>
            <TextBlock Text="day(s)" VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource Muted}"/>
            <CheckBox Content="Show resolved groups" IsChecked="{Binding ShowResolved}" VerticalAlignment="Center" Margin="0,0,16,0"
                      ToolTip="Also list groups where all but one transaction is already marked, so a mark can be undone"/>
            <ui:Button Content="Rescan" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadCommand}" Margin="0,0,16,0"/>
            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource Note}"/>
          <TextBlock DockPanel.Dock="Top" Text="Tick each extra copy, then save them all at once. Ticked transactions stay in the Transactions list (dimmed) but are left out of every report, budget, the dashboard and the AI advisor. &quot;keep&quot; marks the copy Hoard suggests keeping: the one synced from your bank, else the first one stored."
                     Style="{StaticResource Note}" Margin="0,0,0,6"/>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <ui:Button Content="Select suggested" Icon="{ui:SymbolIcon CheckmarkStarburst24}" Command="{Binding SelectSuggestedCommand}" Margin="0,0,8,0"
                         ToolTip="Tick every copy except the suggested keeper in each group"/>
              <ui:Button Content="Not duplicates" Icon="{ui:SymbolIcon DismissCircle24}" Command="{Binding NotDuplicatesCommand}" Margin="0,0,8,0"
                         ToolTip="The selected row's group is genuinely separate purchases; stop offering it"/>
              <ui:Button Content="Reset" Command="{Binding ResetChoicesCommand}" IsEnabled="{Binding HasPendingChanges}" Margin="0,0,8,0"/>
              <ui:Button Content="{Binding SaveText}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" IsEnabled="{Binding HasPendingChanges}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </DockPanel>
          <ui:Card Style="{StaticResource ChartCard}">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionMode="Single">
              <!-- No DataGrid grouping: a GroupStyle collapses every column to its minimum width under this theme (and the row
                   template ignores a row Background). Each row shows its group number as a pill whose color alternates by group. -->
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMarked}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Group" Width="62" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsBanded}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding GroupText}" FontWeight="SemiBold"/>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Duplicate" Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsMarked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" MinWidth="0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Keep" Binding="{Binding KeepHint}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Posted" Binding="{Binding PostedDate, StringFormat=yyyy-MM-dd}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Payee" Binding="{Binding Payee}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource RightCell}"/>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Added" Binding="{Binding Added, StringFormat=yyyy-MM-dd HH:mm}" Width="112" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </ui:Card>
        </DockPanel>
      </TabItem>

      <!-- ============================== Weekly spending ============================== -->
      <TabItem Header="Weekly spending">
        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Weekly}">
          <StackPanel Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ui:Button Content="Analyze with AI" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding AnalyzeCommand}" Margin="0,0,8,0"
                           ToolTip="Ask Claude (the AI Advisor's key and model) for trends and ways to spend less"/>
                <ui:Button Content="Preview email" Icon="{ui:SymbolIcon Mail24}" Command="{Binding PreviewEmailCommand}" Margin="0,0,8,0"
                           ToolTip="Open the email in your browser exactly as it would be sent"/>
                <ui:Button Content="Send now" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Command="{Binding SendNowCommand}"
                           ToolTip="Email this week's report to the recipients below"/>
              </StackPanel>
              <WrapPanel>
                <TextBlock Text="Week" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
                <ComboBox ItemsSource="{Binding WeekOptions}" SelectedItem="{Binding SelectedWeek}" Width="220" Margin="0,0,8,0"/>
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" Appearance="Transparent"/>
              </WrapPanel>
            </DockPanel>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" TextWrapping="Wrap"/>

            <UniformGrid Columns="4" Margin="0,0,-12,10">
              <ui:Card Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Spent this week" Style="{StaticResource KpiLabel}"/>
                  <TextBlock Text="{Binding TotalText}" Style="{StaticResource TileValue}"/>
                  <TextBlock Text="{Binding TotalDetail}" Style="{StaticResource KpiDetail}"/>
                </StackPanel>
              </ui:Card>
              <ui:Card Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="vs. previous week" Style="{StaticResource KpiLabel}"/>
                  <TextBlock Text="{Binding VsPriorWeek, StringFormat='+$#,##0;-$#,##0;$0'}" Style="{StaticResource TileValue}"
                             Foreground="{Binding VsPriorWeek, Converter={StaticResource SpendChangeToBrush}}"/>
                  <TextBlock Text="{Binding PriorDetail}" Style="{StaticResource KpiDetail}"/>
                </StackPanel>
              </ui:Card>
              <ui:Card Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="vs. 4-week average" Style="{StaticResource KpiLabel}"/>
                  <TextBlock Text="{Binding VsFourWeek, StringFormat='+$#,##0;-$#,##0;$0'}" Style="{StaticResource TileValue}"
                             Foreground="{Binding VsFourWeek, Converter={StaticResource SpendChangeToBrush}}"/>
                  <TextBlock Text="{Binding FourWeekDetail}" Style="{StaticResource KpiDetail}"/>
                </StackPanel>
              </ui:Card>
              <ui:Card Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="Share of income" Style="{StaticResource KpiLabel}"/>
                  <TextBlock Text="{Binding IncomeText}" Style="{StaticResource TileValue}"/>
                  <TextBlock Text="{Binding IncomeDetail}" Style="{StaticResource KpiDetail}"/>
                </StackPanel>
              </ui:Card>
            </UniformGrid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Last 13 weeks" Style="{StaticResource CardTitle}"/>
                    <lvc:CartesianChart Series="{Binding TrendSeries}" XAxes="{Binding TrendXAxes}" YAxes="{Binding TrendYAxes}"
                                        FindingStrategy="CompareOnlyX" LegendPosition="Bottom" TooltipPosition="Top" Height="240"/>
                  </DockPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Analysis and ways to spend less" Style="{StaticResource CardTitle}"/>
                    <controls:MarkdownView Markdown="{Binding AiMarkdown}" Margin="0,4,0,0"/>
                  </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="By category group (this week vs. the 4 weeks before)" Style="{StaticResource CardTitle}"/>
                    <DataGrid ItemsSource="{Binding Groups}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Group" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="This week" Binding="{Binding Amount, StringFormat=C0}" Width="95" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="4-wk avg" Binding="{Binding FourWeekAverage, StringFormat=C0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTemplateColumn Header="Change" Width="90">
                          <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Change, StringFormat='+$#,##0;-$#,##0;$0'}" HorizontalAlignment="Right"
                                         Foreground="{Binding Change, Converter={StaticResource SpendChangeToBrush}}"/>
                            </DataTemplate>
                          </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Share" Binding="{Binding Share, StringFormat=P0}" Width="64" ElementStyle="{StaticResource RightCell}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </ui:Card>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Email schedule" Style="{StaticResource CardTitle}"/>
                    <CheckBox Content="Email this report every week" IsChecked="{Binding ScheduleEnabled}" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                      <TextBlock Text="on" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
                      <ComboBox ItemsSource="{Binding DayOptions}" SelectedItem="{Binding SelectedDay}" Width="130" Margin="0,0,8,0"/>
                      <TextBlock Text="at" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource Muted}"/>
                      <ui:TextBox Text="{Binding ScheduleTime, UpdateSourceTrigger=PropertyChanged}" Width="80" PlaceholderText="07:00" ToolTip="24-hour time"/>
                    </StackPanel>
                    <TextBlock Text="Recipients" Style="{StaticResource Muted}" Margin="0,6,0,2"/>
                    <ui:TextBox Text="{Binding RecipientsText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="name@example.com; other@example.com"
                                TextWrapping="Wrap" AcceptsReturn="False"/>
                    <CheckBox Content="Include Claude's analysis and suggestions" IsChecked="{Binding IncludeAi}" Margin="0,8,0,0"
                              ToolTip="Uses the AI Advisor's Anthropic key; each report is one advisor request"/>
                    <ui:Button Content="Save schedule" Appearance="Primary" Command="{Binding SaveScheduleCommand}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding ScheduleSummary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="The report sent on a given day covers the seven days before it. Hoard sends it while it is open; if it was closed, the email goes out when Hoard next starts."/>
                    <ui:Button Content="Set up outgoing email…" Icon="{ui:SymbolIcon Mail24}" Command="{Binding GoToEmailSettingsCommand}" Margin="0,8,0,0"
                               Visibility="{Binding EmailNotConfigured, Converter={StaticResource BoolToVis}}"/>
                  </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Budget this month" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="{Binding BudgetText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Top merchants" Style="{StaticResource CardTitle}"/>
                    <DataGrid ItemsSource="{Binding Merchants}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Merchant" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Times" Binding="{Binding Count}" Width="60" ElementStyle="{StaticResource RightCell}"/>
                        <DataGridTextColumn Header="Spent" Binding="{Binding Amount, StringFormat=C0}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </ui:Card>
                <ui:Card Style="{StaticResource ChartCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="Largest charges" Style="{StaticResource CardTitle}"/>
                    <DataGrid ItemsSource="{Binding Largest}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=ddd M/d}" Width="70"/>
                        <DataGridTextColumn Header="Merchant" Binding="{Binding Merchant}" Width="*"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C2}" Width="90" ElementStyle="{StaticResource RightCell}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </ui:Card>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
