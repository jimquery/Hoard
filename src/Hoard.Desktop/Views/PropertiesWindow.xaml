<ui:FluentWindow x:Class="Hoard.Desktop.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hoard - Real estate" Width="980" Height="600" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Real estate" ShowMaximize="False" ShowMinimize="False"/>

    <StackPanel Grid.Row="1" Margin="20,4,20,8">
      <TextBlock Style="{StaticResource Note}"
                 Text="Properties appear as accounts under the &quot;Real estate&quot; institution and count toward net worth. Values come from RentCast's automated valuation (free plan: 50 lookups per month, so each property is re-valued on its own schedule) or from a value you enter."/>
      <ui:Card Padding="10,8" Margin="0,0,0,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <ui:Button Content="Refresh due values" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshDueCommand}" Margin="0,0,6,0"
                       ToolTip="Re-values online properties whose refresh interval has passed"/>
            <ui:Button Content="Refresh all now" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshAllCommand}"
                       ToolTip="Re-values every online property immediately (uses one RentCast request per property)"/>
          </StackPanel>
          <WrapPanel>
            <ui:Button Content="Add property" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="OnAddClick" Margin="0,0,6,0"/>
            <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Click="OnEditClick" Margin="0,0,6,0"/>
            <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="OnRemoveClick" Margin="0,0,16,0"/>
            <ui:Button Content="RentCast API key..." Icon="{ui:SymbolIcon Key24}" Click="OnApiKeyClick"/>
            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource Muted}" Text="No API key set - online valuations are off."
                       Visibility="{Binding HasApiKey, Converter={StaticResource InverseBoolToVis}}"/>
          </WrapPanel>
        </DockPanel>
      </ui:Card>
      <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>

    <DataGrid Grid.Row="2" Margin="20,0,20,8" ItemsSource="{Binding Properties}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
              SelectionMode="Single" MouseDoubleClick="OnEditClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Property" Binding="{Binding Nickname}" Width="150"/>
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="180"/>
        <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=C0}" Width="110" ElementStyle="{StaticResource RightCell}"/>
        <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="170" ElementStyle="{StaticResource RightCell}"/>
        <DataGridTextColumn Header="Gain" Binding="{Binding Gain}" Width="130" ElementStyle="{StaticResource RightCell}"/>
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="80"/>
        <DataGridTextColumn Header="Valued" Binding="{Binding ValuedAt}" Width="100"/>
      </DataGrid.Columns>
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
          <Setter Property="ToolTip" Value="{Binding Error}"/>
        </Style>
      </DataGrid.RowStyle>
    </DataGrid>

    <DockPanel Grid.Row="3" Margin="20,0,20,16">
      <ui:Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
        <TextBlock Text="Total: " Style="{StaticResource Muted}"/>
        <TextBlock Text="{Binding Total, StringFormat=C0}" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
