<ui:FluentWindow x:Class="Hoard.Desktop.Views.CategoriesRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Hoard - Categories &amp; rules" Width="980" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <DockPanel>
    <ui:TitleBar DockPanel.Dock="Top" Title="Categories &amp; rules" ShowMaximize="False" ShowMinimize="False"/>
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock Text="{Binding Status}"/></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <ProgressBar IsIndeterminate="True" Width="80" Height="12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
      </StatusBarItem>
    </StatusBar>

    <TabControl Margin="8">
      <!-- Rules -->
      <TabItem Header="Rules">
        <DockPanel>
          <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
              <Button Content="New rule..." Click="OnNewRuleClick"/>
              <Button Content="Edit..." Click="OnEditRuleClick"/>
              <Button Content="Enable / disable" Command="{Binding ToggleRuleCommand}"/>
              <Button Content="Delete" Click="OnDeleteRuleClick"/>
              <Separator/>
              <Button Content="Run all rules now" Command="{Binding RunRulesCommand}" ToolTip="Re-applies every enabled rule to all transactions you have not categorized by hand, including imported rows: where a rule matches, it replaces the category the imported file supplied."/>
            </ToolBar>
          </ToolBarTray>
          <TextBlock DockPanel.Dock="Top" Margin="8,6" Foreground="Gray" TextWrapping="Wrap"
                     Text="Rules run in priority order (lowest first); the first match wins. Your rules default to priority 100 so they beat the built-in set (400-500). Double-click a rule to edit it."/>
          <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="8" MouseDoubleClick="OnRuleDoubleClick">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Foreground" Value="Gray"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="On" Binding="{Binding IsEnabled, Mode=OneWay}" Width="40"/>
              <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="60"/>
              <DataGridTextColumn Header="Field" Binding="{Binding MatchField}" Width="90"/>
              <DataGridTextColumn Header="Match" Binding="{Binding MatchType}" Width="90"/>
              <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" Width="*" FontFamily="Consolas"/>
              <DataGridTextColumn Header="Category" Binding="{Binding CategoryPath}" Width="220"/>
              <DataGridTextColumn Header="Account" Binding="{Binding AccountName}" Width="140"/>
              <DataGridTextColumn Header="Hits" Binding="{Binding HitCount}" Width="50"/>
              <DataGridCheckBoxColumn Header="Built-in" Binding="{Binding IsSystem, Mode=OneWay}" Width="60"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Categories -->
      <TabItem Header="Categories">
        <DockPanel>
          <Border DockPanel.Dock="Top" Margin="8" Padding="8" BorderBrush="LightGray" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="New category:" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
              <TextBlock Text="under" VerticalAlignment="Center" Margin="8,0"/>
              <ComboBox ItemsSource="{Binding ParentOptions}" SelectedItem="{Binding NewCategoryParent}" DisplayMemberPath="Path" Width="200" Margin="4"/>
              <TextBlock Text="kind" VerticalAlignment="Center" Margin="8,0"/>
              <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewCategoryKind}" Width="100" Margin="4" ToolTip="Only used for top-level groups; sub-categories inherit their group's kind."/>
              <Button Content="Add" Command="{Binding AddCategoryCommand}"/>
              <Button Content="Delete selected" Click="OnDeleteCategoryClick" Margin="24,4,4,4"/>
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" Margin="8,0,8,6" Foreground="Gray" TextWrapping="Wrap"
                     Text="Rename by editing the Name cell. Hidden categories stay on existing transactions but are not offered in pickers."/>
          <DataGrid ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutoGenerateColumns="False"
                    CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="8">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Group" Binding="{Binding ParentName}" IsReadOnly="True" Width="200"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" IsReadOnly="True" Width="90"/>
              <DataGridCheckBoxColumn Header="Hidden" Binding="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
              <DataGridCheckBoxColumn Header="Built-in" Binding="{Binding IsSystem, Mode=OneWay}" IsReadOnly="True" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
  </DockPanel>
</ui:FluentWindow>
