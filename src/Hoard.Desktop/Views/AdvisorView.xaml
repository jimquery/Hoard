<UserControl x:Class="Hoard.Desktop.Views.AdvisorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Hoard.Desktop.Controls"
             Loaded="OnLoaded">
  <Grid Style="{StaticResource PagePanel}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <TextBlock Text="{Binding SessionCost}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ui:Button Content="New conversation" Icon="{ui:SymbolIcon ChatAdd24}" Command="{Binding NewConversationCommand}" Margin="0,0,8,0"
                   Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}"/>
        <ui:Button Content="Save…" Icon="{ui:SymbolIcon Save24}" Click="OnExportClick" Margin="0,0,8,0" IsEnabled="{Binding HasMessages}"
                   ToolTip="Save this conversation as a Markdown file"/>
        <ui:Button Content="Settings" Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="AI Advisor" Style="{StaticResource PageTitle}"/>
        <TextBlock Style="{StaticResource Note}"
                   Text="Ask Claude about your money. It reads your Hoard figures to analyse spending and suggest how to save, cut costs and grow your net worth. General information, not regulated financial advice."/>
      </StackPanel>
    </DockPanel>

    <!-- ============================== Settings / consent ============================== -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVis}}">
      <ui:Card Padding="20,16" MaxWidth="820" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="Before you turn the advisor on" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
          <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
            Everything else in Hoard stays on this PC. The advisor is the exception: it sends your questions, and the figures it looks up to answer them,
            to Anthropic's Claude API over an encrypted connection, using your own Anthropic API key (billed to your Anthropic account, typically a few
            cents to a few tens of cents per answer). Anthropic does not use API data to train models.
          </TextBlock>
          <TextBlock Text="What it can read (only when it needs to, and never your account numbers, logins or bank credentials):" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock TextWrapping="Wrap" Margin="12,0,0,10" Style="{StaticResource Muted}">
            • Account names, institutions, types, owners and current balances; net worth and its history<LineBreak/>
            • Monthly income, expenses and savings rate; spending by category and category group; your budget targets and forecasts<LineBreak/>
            • Household members' first names, relationships and ages (not dates of birth)<LineBreak/>
            • With transaction detail allowed: merchant names, subscriptions, and individual transactions (date, description, amount, category)
          </TextBlock>
          <CheckBox IsChecked="{Binding AllowTransactionDetail}" Margin="0,0,0,6"
                    Content="Allow transaction detail (merchants, subscriptions, transaction search) — better, more specific advice"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
            <TextBlock Text="Depth" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox ItemsSource="{Binding EffortOptions}" SelectedItem="{Binding Effort}" Width="120"
                      ToolTip="How hard Claude thinks before answering. High gives the most thorough analysis; low is faster and cheaper."/>
          </StackPanel>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Anthropic API key" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel Grid.Column="1">
              <PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyChanged" MaxWidth="460" HorizontalAlignment="Left" Width="460"/>
              <TextBlock Style="{StaticResource KpiDetail}">
                <Run Text="Create one at "/><Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="OnNavigate">console.anthropic.com</Hyperlink><Run Text=". It is stored encrypted, like your bank keys."/>
              </TextBlock>
              <TextBlock Text="A key is saved — leave the box blank to keep it." FontWeight="SemiBold" Style="{StaticResource KpiDetail}"
                         Foreground="{DynamicResource SystemFillColorSuccessBrush}" Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </Grid>
          <CheckBox IsChecked="{Binding Accepted}" Margin="0,0,0,12" FontWeight="SemiBold"
                    Content="I understand the advisor sends my questions and the figures above to Anthropic to answer them."/>
          <StackPanel Orientation="Horizontal">
            <ui:Button Content="Save and start" Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Command="{Binding SaveSettingsCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="Turn off and delete key" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Command="{Binding TurnOffCommand}"
                       Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <TextBlock Text="{Binding SettingsStatus}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </ui:Card>
    </ScrollViewer>

    <!-- ============================== Conversation ============================== -->
    <Grid Grid.Row="1" Visibility="{Binding ShowSettings, Converter={StaticResource InverseBoolToVis}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <ui:Card Grid.Row="0" Padding="0" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid>
          <!-- Starter prompts while the conversation is empty -->
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760" Margin="24"
                      Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVis}}">
            <ui:SymbolIcon Symbol="Sparkle24" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="What would you like to look at?" Style="{StaticResource Headline}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <ItemsControl ItemsSource="{Binding Prompts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <ui:Button Margin="5" Padding="12,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                             Command="{Binding DataContext.AskPromptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                             ToolTip="{Binding Question}">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Question}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" FontSize="12"/>
                    </StackPanel>
                  </ui:Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" Padding="20,12"
                        Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="900">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,6">
                    <!-- Question -->
                    <Border HorizontalAlignment="Right" MaxWidth="640" CornerRadius="10" Padding="14,9"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <!-- Answer -->
                    <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource BoolToVis}}">
                      <controls:MarkdownView Markdown="{Binding Text}"/>
                      <TextBlock Text="{Binding Footer}" Style="{StaticResource KpiDetail}" Margin="2,0,0,4"/>
                    </StackPanel>
                    <!-- Data-reading step -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsStep, Converter={StaticResource BoolToVis}}">
                      <ui:SymbolIcon Symbol="DatabaseSearch24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                      <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <!-- Error -->
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </ui:Card>

      <DockPanel Grid.Row="1" Margin="0,10,0,0">
        <ui:Button DockPanel.Dock="Right" Content="Send" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Command="{Binding AskCommand}" Margin="8,0,0,0"
                   VerticalAlignment="Bottom" MinWidth="90" Visibility="{Binding IsThinking, Converter={StaticResource InverseBoolToVis}}"/>
        <ui:Button DockPanel.Dock="Right" Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopCommand}" Margin="8,0,0,0"
                   VerticalAlignment="Bottom" MinWidth="90" Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"/>
        <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="20" Height="20" Margin="10,0,0,8" VerticalAlignment="Bottom"
                         Visibility="{Binding IsThinking, Converter={StaticResource BoolToVis}}"/>
        <ui:TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ask about your spending, budget, savings or net worth… (Enter to send, Shift+Enter for a new line)"
                    AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnQuestionKeyDown"/>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
