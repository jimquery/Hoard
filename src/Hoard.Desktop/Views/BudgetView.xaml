<UserControl x:Class="Hoard.Desktop.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <Style x:Key="Tile" TargetType="ui:Card">
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style x:Key="TileValue" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
      <Setter Property="FontSize" Value="22"/>
    </Style>
  </UserControl.Resources>

  <Grid Style="{StaticResource PagePanel}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        <TextBlock Text="Month" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Label" Width="170" Margin="0,0,12,0"/>
        <ui:Button Content="Use suggested targets" Icon="{ui:SymbolIcon Sparkle24}" Appearance="Primary" Command="{Binding UseSuggestedCommand}" Margin="0,0,8,0"
                   ToolTip="Give every category group that has no target its suggested target (the forecast, rounded up)"/>
        <ui:Button Content="Reset all…" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnResetAllClick" Margin="0,0,8,0"
                   ToolTip="Replace every target with its suggestion from this month on"/>
        <ui:Button Content="Report" Icon="{ui:SymbolIcon DataBarHorizontal24}" Command="{Binding ShowReportCommand}" Margin="0,0,8,0"
                   ToolTip="Reports › Budget vs. actual"/>
        <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding LoadCommand}"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Budget" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>

    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-12,10">
      <ui:Card Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Monthly targets" Style="{StaticResource KpiLabel}"/>
          <TextBlock Text="{Binding TotalTarget, StringFormat=C0}" Style="{StaticResource TileValue}"/>
          <TextBlock Text="{Binding TargetDetail}" Style="{StaticResource KpiDetail}"/>
        </StackPanel>
      </ui:Card>
      <ui:Card Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Forecast (all groups)" Style="{StaticResource KpiLabel}"/>
          <TextBlock Text="{Binding TotalForecast, StringFormat=C0}" Style="{StaticResource TileValue}"/>
          <TextBlock Text="from the last 12 months" Style="{StaticResource KpiDetail}"/>
        </StackPanel>
      </ui:Card>
      <ui:Card Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Spent" Style="{StaticResource KpiLabel}"/>
          <TextBlock Text="{Binding TotalActual, StringFormat=C0}" Style="{StaticResource TileValue}"/>
          <TextBlock Text="{Binding ActualDetail}" Style="{StaticResource KpiDetail}"/>
        </StackPanel>
      </ui:Card>
      <ui:Card Style="{StaticResource Tile}">
        <StackPanel>
          <TextBlock Text="Projected month end" Style="{StaticResource KpiLabel}"/>
          <TextBlock Text="{Binding TotalProjected, StringFormat=C0}" Style="{StaticResource TileValue}"/>
          <TextBlock Text="{Binding ProjectedDetail}" Style="{StaticResource KpiDetail}"/>
          <TextBlock Text="{Binding Unbudgeted, StringFormat='{}{0:C0} in groups without a target'}" Style="{StaticResource KpiDetail}"/>
        </StackPanel>
      </ui:Card>
    </UniformGrid>

    <TextBlock Grid.Row="2" Text="{Binding MonthNote}" Style="{StaticResource Note}"/>

    <ui:Card Grid.Row="3" Padding="8" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
      <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionUnit="Cell" RowHeight="40">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="" Width="22" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource BudgetStatusBrush}}" ToolTip="{Binding StatusText}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Category group" Binding="{Binding Group, Mode=OneWay}" IsReadOnly="True" Width="*" FontWeight="SemiBold"/>
          <DataGridTemplateColumn Header="Last 12 months" Width="130" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding Spark}" Height="26" VerticalAlignment="Center">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Width="9" Height="26" Background="Transparent" ToolTip="{Binding Tip}">
                        <Border Width="6" VerticalAlignment="Bottom" CornerRadius="1.5"
                                Height="{Binding Height, Converter={StaticResource Scale}, ConverterParameter=26}"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.75"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Typical" Binding="{Binding Typical, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource RightCell}"/>
          <DataGridTemplateColumn Header="Trend" Width="95" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding TrendText}" ToolTip="{Binding TrendTip}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Forecast" Width="85" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Forecast, StringFormat=C0}" ToolTip="{Binding ForecastRange}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Target / month" Width="120">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBox Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanHaveTarget}"
                         LostKeyboardFocus="OnTargetLostFocus" KeyDown="OnTargetKeyDown" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                         ToolTip="{Binding Suggested, StringFormat='Monthly target from the month shown on. Suggested: {0:C0}. Blank = no target.'}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Spent" Binding="{Binding Actual, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource RightCell}"/>
          <DataGridTextColumn Header="Projected" Binding="{Binding Projected, StringFormat=C0, Mode=OneWay}" IsReadOnly="True" Width="85" ElementStyle="{StaticResource RightCell}"/>
          <DataGridTemplateColumn Header="Used" Width="130" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid VerticalAlignment="Center" Margin="4,0">
                  <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="6"
                               Foreground="{Binding Status, Converter={StaticResource BudgetStatusBrush}}"
                               Visibility="{Binding CanHaveTarget, Converter={StaticResource BoolToVis}}"/>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Left" Width="80" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Remaining, StringFormat=C0}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{Binding Remaining, Converter={StaticResource AmountToBrush}}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Status" Width="110" IsReadOnly="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{Binding Status, Converter={StaticResource BudgetStatusBrush}}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </ui:Card>
  </Grid>
</UserControl>
