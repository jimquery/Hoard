<ui:FluentWindow x:Class="Hoard.Desktop.Views.AccountTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Hoard.Desktop.ViewModels"
        Title="Hoard - Account types" Width="760" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" Loaded="OnLoaded">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" Title="Account types" ShowMaximize="False" ShowMinimize="False"/>

    <StackPanel Grid.Row="1" Margin="20,4,20,8">
      <TextBlock Text="Account types group accounts on the dashboard and in reports. Liability types subtract from net worth. Tick Spending reports for the types whose transactions should count in Income vs. expenses and Spending by category (Cash and Credit Card by default; accounts without a type are left out). Rename by editing the Name cell; pick a color from the swatches." Style="{StaticResource Note}"/>
      <ui:Card Padding="10,8">
        <StackPanel Orientation="Horizontal">
          <ui:TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="New type name" Width="220" Margin="0,0,10,0"/>
          <CheckBox Content="Liability" IsChecked="{Binding NewIsLiability}" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ui:Button Content="Add type" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Command="{Binding AddCommand}" Margin="0,0,16,0"/>
          <ui:Button Icon="{ui:SymbolIcon ArrowUp24}" Content="Move up" Command="{Binding MoveUpCommand}" Margin="0,0,6,0"/>
          <ui:Button Icon="{ui:SymbolIcon ArrowDown24}" Content="Move down" Command="{Binding MoveDownCommand}" Margin="0,0,16,0"/>
          <ui:Button Icon="{ui:SymbolIcon Delete24}" Content="Delete" Appearance="Danger" Click="OnDeleteClick"/>
        </StackPanel>
      </ui:Card>
    </StackPanel>

    <DataGrid Grid.Row="2" Margin="20,0,20,8" ItemsSource="{Binding Types}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Color" Width="200">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ItemsControl ItemsSource="{Binding Source={x:Static vm:AccountTypesViewModel.ColorChoices}}" Margin="2">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Tag="{Binding}" Click="OnSwatchClick" Margin="1" Padding="0" MinWidth="0" MinHeight="0" ToolTip="{Binding}" Cursor="Hand">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Converter={StaticResource HexToBrush}}"/>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="" Width="36">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Border Width="14" Height="14" CornerRadius="7" Background="{Binding Color, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Center"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="*"/>
        <DataGridCheckBoxColumn Header="Liability" Binding="{Binding IsLiability, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
        <DataGridTextColumn Header="Kind" Binding="{Binding KindText, Mode=OneWay}" IsReadOnly="True" Width="80"/>
        <DataGridCheckBoxColumn Header="Spending reports" Binding="{Binding IncludeInSpending, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
        <DataGridTextColumn Header="Accounts" Binding="{Binding AccountCount, Mode=OneWay}" IsReadOnly="True" Width="80" ElementStyle="{StaticResource RightCell}"/>
        <DataGridCheckBoxColumn Header="Built-in" Binding="{Binding IsSystem, Mode=OneWay}" IsReadOnly="True" Width="70"/>
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Margin="20,0,20,16">
      <ui:Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90"/>
      <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>
  </Grid>
</ui:FluentWindow>
