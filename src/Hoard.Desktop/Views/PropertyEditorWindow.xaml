<ui:FluentWindow x:Class="Hoard.Desktop.Views.PropertyEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Hoard.Desktop.ViewModels"
        Title="Hoard - Property" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
  <ui:FluentWindow.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>
  </ui:FluentWindow.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" x:Name="Bar" Title="Property" ShowMaximize="False" ShowMinimize="False"/>

    <StackPanel Grid.Row="1" Margin="20,4,20,20">
      <TextBlock Text="Address" Style="{StaticResource SectionTitle}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Street address" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="123 Main St"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Unit / line 2 (optional)" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Apt 4"/>
        </StackPanel>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="80"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="City" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="State" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding State, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="OH" MaxLength="2" CharacterCasing="Upper"/>
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="ZIP" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding Zip, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="45501"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="Details" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Nickname (shown as the account name)" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Home"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Property type (improves the estimate)" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Source={x:Static vm:PropertyEditorViewModel.PropertyTypes}}" SelectedItem="{Binding PropertyType}" HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Bedrooms" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding Bedrooms, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Bathrooms" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding Bathrooms, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="4">
          <TextBlock Text="Sq. ft." Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding SquareFootage, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="6">
          <TextBlock Text="Purchase price" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="$"/>
        </StackPanel>
        <StackPanel Grid.Column="8">
          <TextBlock Text="Purchase date" Style="{StaticResource FieldLabel}"/>
          <DatePicker SelectedDate="{Binding PurchaseDate}"/>
        </StackPanel>
      </Grid>

      <TextBlock Text="Valuation" Style="{StaticResource SectionTitle}" Margin="0,16,0,0"/>
      <ui:ToggleSwitch IsChecked="{Binding UseOnlineValue}" Content="Look up the value online (RentCast)" Margin="0,8,0,0"/>
      <Grid Visibility="{Binding UseOnlineValue, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Re-value every (days)" Style="{StaticResource FieldLabel}"/>
          <ui:NumberBox Value="{Binding RefreshDays}" Minimum="1" Maximum="365" SmallChange="1" SpinButtonPlacementMode="Inline"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Style="{StaticResource Note}" VerticalAlignment="Bottom" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Each lookup uses one RentCast request. The free plan allows 50 per month, so 30 days is a good default for a few properties."/>
      </Grid>
      <Grid Visibility="{Binding UseOnlineValue, Converter={StaticResource InverseBoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Current value" Style="{StaticResource FieldLabel}"/>
          <ui:TextBox Text="{Binding ManualValue, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="$"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Style="{StaticResource Note}" VerticalAlignment="Bottom" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Enter your own estimate. If left blank the purchase price is used. Update it any time; each change is kept in the value history."/>
      </Grid>

      <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <ui:Button Content="Save" Appearance="Primary" IsDefault="True" Click="OnSaveClick" MinWidth="90" Margin="0,0,8,0"/>
        <ui:Button Content="Cancel" IsCancel="True" MinWidth="90"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
